
#
# configure board <your-board-name>
#
CONFIG_OPERATING_SYSTEM=100
CONFIG_LITTLE_END=1
CONFIG_ENABLE_FILE_SYSTEM=y
CONFIG_ENABLE_WIFI=y
CONFIG_ENABLE_WIRED=y
CONFIG_ENABLE_BLUETOOTH=y
# CONFIG_ENABLE_NB is not set
# CONFIG_ENABLE_CELLULAR is not set
# CONFIG_ENABLE_ZIGBEE is not set
# CONFIG_ENABLE_THIRD_NETWORK is not set
# CONFIG_ENABLE_RTC is not set
# CONFIG_ENABLE_WATCHDOG is not set
CONFIG_ENABLE_UART=y
CONFIG_ENABLE_FLASH=y
CONFIG_TUYA_FLASH_TYPE_MAX_PARTITION_NUM=10
# CONFIG_ENABLE_ADC is not set
# CONFIG_ENABLE_PWM is not set
CONFIG_ENABLE_GPIO=y
# CONFIG_ENABLE_I2C is not set
# CONFIG_ENABLE_SPI is not set
# CONFIG_ENABLE_TIMER is not set
# CONFIG_ENABLE_DISPLAY is not set
CONFIG_ENABLE_MEDIA=y
# CONFIG_ENABLE_PM is not set
# CONFIG_ENABLE_STORAGE is not set
# CONFIG_ENABLE_DAC is not set
# CONFIG_ENABLE_I2S is not set
# CONFIG_ENABLE_WAKEUP is not set
# CONFIG_ENABLE_REGISTER is not set
# CONFIG_ENABLE_PINMUX is not set
# CONFIG_ENABLE_PLATFORM_AES is not set
# CONFIG_ENABLE_PLATFORM_SHA256 is not set
# CONFIG_ENABLE_PLATFORM_MD5 is not set
# CONFIG_ENABLE_PLATFORM_SHA1 is not set
# CONFIG_ENABLE_PLATFORM_RSA is not set
# CONFIG_ENABLE_PLATFORM_ECC is not set
# CONFIG_ENABLE_IPv6 is not set
# end of configure board <your-board-name>
